<?xml version="1.0"?>
<ruleset name="MasjidFeed App">
    <description>Sniffs matching the WordPress Plugin Check categories for the MasjidFeed App plugin.</description>

    <rule ref="WordPress.Security.EscapeOutput" />
    <rule ref="WordPress.Security.NonceVerification" />
    <rule ref="WordPress.Security.ValidatedSanitizedInput" />
    <rule ref="WordPress.DB.DirectDatabaseQuery" />
    <rule ref="WordPress.DB.PreparedSQL" />
    <rule ref="WordPress.DB.SlowDBQuery" />
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals" />

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <file>wp-content/plugins/masjidfeed-app/includes</file>
    <file>wp-content/plugins/masjidfeed-app/masjidfeed-app.php</file>
    <file>wp-content/plugins/masjidfeed-app/templates</file>
    <file>wp-content/plugins/masjidfeed-app/uninstall.php</file>
</ruleset>
