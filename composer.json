{
    "name": "bothellmosque/masjidfeed-app",
    "description": "WordPress backend for the MasjidFeed mobile app.",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "firebase/php-jwt": "^7.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "humbug/php-scoper": "^0.18.19",
        "wp-coding-standards/wpcs": "^3.2"
    },
    "scripts": {
        "build-release": "php scripts/build-release.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "humbug/php-scoper": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "repositories": {
    }
}
